<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Root theme: window bg + bars, day/night via color refs -->
    <style name="Theme.XavierDrive" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/window_bg</item>
        <item name="android:statusBarColor">@color/bg_deep</item>
        <item name="android:navigationBarColor">@color/bg_deep</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Splash: cinematic gradient overrides the window bg anyway -->
    <style name="Theme.XavierDrive.Splash">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Login: immersive, theme-aware bars -->
    <style name="Theme.XavierDrive.Login">
        <item name="android:windowBackground">@color/login_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/login_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
    </style>

    <!-- Main WebView shell -->
    <style name="Theme.XavierDrive.Main">
        <item name="android:statusBarColor">@color/bg_deep</item>
        <item name="android:navigationBarColor">@color/bg_deep</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Dialogs matching the login theme -->
    <style name="Theme.XavierDrive.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
    </style>
</resources>
