<?xml version="1.0" encoding="utf-8"?>
<!-- LOGBOOK (v1.1.0) — class activity photo diary. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/home_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="8dp"
        android:paddingRight="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/lb_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:scaleType="centerInside"
            android:padding="10dp"
            android:src="@drawable/ic_chevron"
            android:rotation="180"
            android:tint="@color/home_ink"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/logbook_title"
            android:textSize="20sp"
            android:fontFamily="@font/inter_medium"
            android:textColor="@color/home_ink" />

        <TextView
            android:id="@+id/lb_add"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:background="@drawable/btn_primary"
            android:textSize="13sp"
            android:fontFamily="@font/inter_medium"
            android:textColor="@color/home_hero_ink"
            android:text="@string/add_entry"
            android:visibility="gone" />
    </LinearLayout>

    <!-- class + section filters (owner order v1.2.0) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginTop="4dp">

        <Spinner
            android:id="@+id/lb_class"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="3"
            android:background="@drawable/chip_off" />

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <Spinner
            android:id="@+id/lb_section"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="2"
            android:background="@drawable/chip_off" />
    </LinearLayout>

    <!-- date filter — All dates or one specific day (owner order v1.2.0) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginTop="8dp"
        android:paddingLeft="12dp"
        android:paddingRight="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:background="@drawable/home_search_bg">

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/ic_calendar_today"
            android:tint="@color/home_muted"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/lb_date_btn"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:layout_marginLeft="8dp"
            android:textSize="13sp"
            android:fontFamily="@font/inter_medium"
            android:textColor="@color/home_ink"
            android:text="@string/all_dates" />

        <ImageView
            android:id="@+id/lb_date_clear"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="7dp"
            android:src="@drawable/ic_close"
            android:tint="@color/home_muted"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/all_dates" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/lb_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="20dp" />
        </ScrollView>

        <LinearLayout
            android:id="@+id/lb_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_gravity="center">

            <ProgressBar
                android:layout_width="36dp"
                android:layout_height="36dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="13sp"
                android:textColor="@color/home_muted"
                android:text="@string/logbook_loading" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lb_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="26dp"
            android:paddingBottom="26dp"
            android:background="@drawable/row_card"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/home_tile_bg">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_camera"
                    android:tint="@color/home_tile_ink"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_horizontal"
                android:textSize="15sp"
                android:fontFamily="@font/outfit_medium"
                android:textColor="@color/home_ink"
                android:text="@string/logbook_empty" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_horizontal"
                android:textSize="12.5sp"
                android:fontFamily="@font/inter_regular"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/home_muted"
                android:text="@string/logbook_empty_sub" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
