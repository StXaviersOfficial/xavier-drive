<?xml version="1.0" encoding="utf-8"?>
<!-- ════════════════════════════════════════════════════════════════════
     STUDENT MENU (default workspace) — v1.2.0.

     The daily surface: greeting block (avatar + "Good evening," + name +
     rank + date + the ROLE SWITCHER on that same line — owner order), a
     big class selector (it drives the default class in every tool), the
     newest notice as real expandable content, and the school tools as
     LARGE detailed cards in the owner's exact order:
     Files · Live · Notices · Logbook · Timetable.
     ════════════════════════════════════════════════════════════════════ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- greeting block: avatar left, texts, role switcher on the name line -->
    <LinearLayout
        android:id="@+id/std_greeting_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="18dp">

        <!-- account photo — circular crop, taps open the Profile tab -->
        <FrameLayout
            android:id="@+id/avatar"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/home_avatar_bg"
            android:foreground="@drawable/home_ripple_circle"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/home_avatar_cd">

            <ImageView
                android:id="@+id/avatar_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/avatar_initial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="21sp"
                android:fontFamily="@font/outfit_semibold"
                android:textColor="#FFFFFF"
                android:text="X" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginLeft="14dp">

            <TextView
                android:id="@+id/greeting_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:fontFamily="@font/inter_regular"
                android:textColor="@color/home_muted"
                android:text="@string/home_greeting_evening" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/greeting_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="22sp"
                    android:fontFamily="@font/outfit_medium"
                    android:textColor="@color/home_ink"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/home_name_default" />

                <TextView
                    android:id="@+id/role_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:background="@drawable/home_role_chip_bg"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:textSize="10.5sp"
                    android:fontFamily="@font/inter_medium"
                    android:textColor="@color/home_role_ink"
                    android:text="@string/ws_student" />
            </LinearLayout>

            <TextView
                android:id="@+id/date_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textSize="12sp"
                android:fontFamily="@font/inter_regular"
                android:textColor="@color/home_muted"
                android:text="" />
        </LinearLayout>

        <!-- the role (workspace) switcher — on the greeting's line, exactly
             where the owner asked for it. Hidden for pure students. -->
        <FrameLayout
            android:id="@+id/std_switch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="10dp"
            android:background="@drawable/home_tile_bg"
            android:foreground="@drawable/home_ripple_chip"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:contentDescription="@string/ws_switch_cd">

            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_swap"
                android:tint="@color/home_tile_ink"
                android:contentDescription="@null" />
        </FrameLayout>
    </LinearLayout>

    <!-- v1.1.4: the big class selector card was removed — the class lives
         in Profile only (owner order). -->

    <!-- newest notice — real content, tap to read the whole message -->
    <LinearLayout
        android:id="@+id/notice_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/home_card_bg"
        android:foreground="@drawable/home_ripple_card"
        android:elevation="1dp"
        android:clickable="true"
        android:focusable="true"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:fontFamily="@font/inter_medium"
                android:letterSpacing="0.14"
                android:textColor="@color/home_muted"
                android:text="@string/latest_notice_tag" />

            <TextView
                android:id="@+id/notice_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="@drawable/home_badge_chip"
                android:textSize="10sp"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/home_badge_ink"
                android:visibility="gone"
                android:text="@string/notices_new_badge" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/notice_caret"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron"
                android:tint="@color/home_muted"
                android:contentDescription="@null" />
        </LinearLayout>

        <TextView
            android:id="@+id/notice_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="15sp"
            android:fontFamily="@font/inter_medium"
            android:textColor="@color/home_ink"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="@string/latest_notice_loading" />

        <TextView
            android:id="@+id/notice_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textSize="12sp"
            android:fontFamily="@font/inter_regular"
            android:textColor="@color/home_muted"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/latest_notice_meta_none" />

        <!-- the full message, revealed on tap -->
        <TextView
            android:id="@+id/notice_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="13.5sp"
            android:fontFamily="@font/inter_regular"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/home_muted"
            android:visibility="gone"
            android:text="" />

        <View
            android:id="@+id/notice_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="@color/home_hairline"
            android:visibility="gone" />

        <TextView
            android:id="@+id/notice_view_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="2dp"
            android:textSize="12.5sp"
            android:fontFamily="@font/inter_medium"
            android:textColor="@color/home_brand"
            android:visibility="gone"
            android:text="@string/latest_notice_view_all" />
    </LinearLayout>

    <!-- school tools -->
    <TextView
        android:id="@+id/std_tools_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginTop="26dp"
        android:textSize="12sp"
        android:fontFamily="@font/inter_medium"
        android:letterSpacing="0.06"
        android:textColor="@color/home_muted"
        android:text="@string/section_school_tools" />

    <!-- big tool cards — the owner's exact order, two columns:
         Files | Live, then Notices | Logbook, then Timetable full-width -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <!-- Files -->
        <LinearLayout
            android:id="@+id/tile_files"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="16dp"
            android:paddingBottom="14dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_marginRight="5dp"
            android:background="@drawable/home_card_bg"
            android:foreground="@drawable/home_ripple_card"
            android:elevation="1dp"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/home_tile_bg">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_folder"
                    android:tint="@color/home_tile_ink"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="14.5sp"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/home_ink"
                android:text="@string/home_files" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:textSize="11sp"
                android:fontFamily="@font/inter_regular"
                android:textColor="@color/home_muted"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="@string/home_files_desc" />
        </LinearLayout>

        <!-- Live -->
        <LinearLayout
            android:id="@+id/tile_live"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="16dp"
            android:paddingBottom="14dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_marginLeft="5dp"
            android:background="@drawable/home_card_bg"
            android:foreground="@drawable/home_ripple_card"
            android:elevation="1dp"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/home_tile_bg">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_live"
                    android:tint="@color/home_tile_ink"
                    android:contentDescription="@null" />

                <View
                    android:id="@+id/live_badge"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="4dp"
                    android:background="@drawable/home_badge_dot" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="14.5sp"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/home_ink"
                android:text="@string/home_live" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:textSize="11sp"
                android:fontFamily="@font/inter_regular"
                android:textColor="@color/home_muted"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="@string/home_live_desc" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <!-- Notices -->
        <LinearLayout
            android:id="@+id/tile_notices"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="16dp"
            android:paddingBottom="14dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_marginRight="5dp"
            android:background="@drawable/home_card_bg"
            android:foreground="@drawable/home_ripple_card"
            android:elevation="1dp"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/home_tile_bg">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_megaphone"
                    android:tint="@color/home_tile_ink"
                    android:contentDescription="@null" />

                <View
                    android:id="@+id/notices_badge"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="4dp"
                    android:background="@drawable/home_badge_dot"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="14.5sp"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/home_ink"
                android:text="@string/home_notices" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:textSize="11sp"
                android:fontFamily="@font/inter_regular"
                android:textColor="@color/home_muted"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="@string/home_notices_desc" />
        </LinearLayout>

        <!-- Logbook -->
        <LinearLayout
            android:id="@+id/tile_logbook"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="16dp"
            android:paddingBottom="14dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_marginLeft="5dp"
            android:background="@drawable/home_card_bg"
            android:foreground="@drawable/home_ripple_card"
            android:elevation="1dp"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/home_tile_bg">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_book"
                    android:tint="@color/home_tile_ink"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="14.5sp"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/home_ink"
                android:text="@string/home_logbook" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:textSize="11sp"
                android:fontFamily="@font/inter_regular"
                android:textColor="@color/home_muted"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="@string/home_logbook_desc" />
        </LinearLayout>
    </LinearLayout>

    <!-- Timetable — the fifth tool, full-width -->
    <LinearLayout
        android:id="@+id/tile_timetable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:background="@drawable/home_card_bg"
        android:foreground="@drawable/home_ripple_card"
        android:elevation="1dp"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/home_tile_bg">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_calendar"
                android:tint="@color/home_tile_ink"
                android:contentDescription="@null" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginLeft="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14.5sp"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/home_ink"
                android:text="@string/home_timetable" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="11sp"
                android:fontFamily="@font/inter_regular"
                android:textColor="@color/home_muted"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/home_timetable_desc" />
        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_chevron"
            android:tint="@color/home_muted"
            android:contentDescription="@null" />
    </LinearLayout>
</LinearLayout>
