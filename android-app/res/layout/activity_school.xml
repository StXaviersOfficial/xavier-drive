<?xml version="1.0" encoding="utf-8"?>
<!-- SCHOOL (v1.1.0) — school identity / contacts (facts from
     school-info.md, the researched single source of truth). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/home_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="8dp"
        android:paddingRight="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/sc_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:scaleType="centerInside"
            android:padding="10dp"
            android:src="@drawable/ic_chevron"
            android:rotation="180"
            android:tint="@color/home_ink"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/school_title"
            android:textSize="20sp"
            android:fontFamily="@font/inter_medium"
            android:textColor="@color/home_ink" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- hero -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/home_hero_bg"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/school_identity"
                    android:textSize="19sp"
                    android:fontFamily="@font/inter_medium"
                    android:textColor="@color/home_hero_ink" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/school_address"
                    android:textSize="13sp"
                    android:textColor="@color/home_hero_sub" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Where Discipline Meets Opportunity"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter_medium"
                    android:textColor="@color/home_hero_sub" />
            </LinearLayout>

            <!-- facts -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/row_card"
                android:padding="14dp">

                <TextView style="@style/SchoolFactLabel"
                    android:text="Board" />
                <TextView style="@style/SchoolFactValue"
                    android:text="CBSE · English medium · Established 1976" />

                <TextView style="@style/SchoolFactLabel"
                    android:layout_marginTop="12dp"
                    android:text="Grades" />
                <TextView style="@style/SchoolFactValue"
                    android:text="Nursery to Class 12 · Co-educational" />

                <TextView style="@style/SchoolFactLabel"
                    android:layout_marginTop="12dp"
                    android:text="Managed by" />
                <TextView style="@style/SchoolFactValue"
                    android:text="Chandra Children Welfare Society" />

                <TextView style="@style/SchoolFactLabel"
                    android:layout_marginTop="12dp"
                    android:text="Leadership" />
                <TextView style="@style/SchoolFactValue"
                    android:text="Principal: Mrs. Asha Kiran Sinha · Chairman: S. Chandra" />

                <TextView style="@style/SchoolFactLabel"
                    android:layout_marginTop="12dp"
                    android:text="Office hours" />
                <TextView style="@style/SchoolFactValue"
                    android:text="Mon–Sat 8:00 AM – 2:00 PM · Sunday closed" />
            </LinearLayout>

            <!-- contact rows -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/row_card">

                <LinearLayout
                    android:id="@+id/sc_call"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:background="@drawable/home_ripple_card">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_phone"
                        android:tint="@color/home_muted"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginLeft="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="@color/home_ink"
                            android:text="Call the school" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="@color/home_muted"
                            android:text="+91 98350 61341" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_chevron"
                        android:tint="@color/home_nav_inactive"
                        android:contentDescription="@null" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="46dp"
                    android:background="@color/home_hairline" />

                <LinearLayout
                    android:id="@+id/sc_mail"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:background="@drawable/home_ripple_card">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_mail"
                        android:tint="@color/home_muted"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginLeft="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="@color/home_ink"
                            android:text="Email" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="@color/home_muted"
                            android:text="helpdesk@stxaviers.org" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_chevron"
                        android:tint="@color/home_nav_inactive"
                        android:contentDescription="@null" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="46dp"
                    android:background="@color/home_hairline" />

                <LinearLayout
                    android:id="@+id/sc_map"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:background="@drawable/home_ripple_card">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_pin"
                        android:tint="@color/home_muted"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginLeft="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="@color/home_ink"
                            android:text="Find us" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="@color/home_muted"
                            android:text="Goshala Road, Ramna, Muzaffarpur" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_chevron"
                        android:tint="@color/home_nav_inactive"
                        android:contentDescription="@null" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
