<?xml version="1.0" encoding="utf-8"?>
<!-- NOTICES (v1.1.2) — a school tool screen (no bottom bar; back to the
     tools that opened it). Sections group the feed: School-wide first,
     then each class with its own header — the separation system the
     owner asked for. Cards expand to the full message on tap. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/home_bg">

    <!-- header + back -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="8dp"
        android:paddingRight="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/notices_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:scaleType="centerInside"
            android:padding="10dp"
            android:src="@drawable/ic_chevron"
            android:rotation="180"
            android:tint="@color/home_ink"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/screen_notices"
                android:textSize="20sp"
                android:fontFamily="@font/outfit_medium"
                android:textColor="@color/home_ink" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/home_notices_sub"
                android:textSize="12.5sp"
                android:fontFamily="@font/inter_regular"
                android:textColor="@color/home_muted" />
        </LinearLayout>

        <TextView
            android:id="@+id/notices_new"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:gravity="center"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:background="@drawable/btn_primary"
            android:textSize="13sp"
            android:fontFamily="@font/inter_medium"
            android:textColor="@color/home_hero_ink"
            android:text="@string/post_notice"
            android:visibility="gone" />
    </LinearLayout>

    <!-- class filter (owner order v1.2.0) -->
    <Spinner
        android:id="@+id/notices_class"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/chip_off" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/notices_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingTop="6dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            android:scrollbars="none"
            android:listSelector="@android:color/transparent" />

        <LinearLayout
            android:id="@+id/notices_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_gravity="center">

            <ProgressBar
                android:layout_width="36dp"
                android:layout_height="36dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="13sp"
                android:textColor="@color/home_muted"
                android:text="@string/notices_loading" />
        </LinearLayout>

        <!-- empty state — full width, composed like a real card -->
        <LinearLayout
            android:id="@+id/notices_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="26dp"
            android:paddingBottom="26dp"
            android:background="@drawable/row_card"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/home_tile_bg">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_megaphone"
                    android:tint="@color/home_tile_ink"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_horizontal"
                android:textSize="15sp"
                android:fontFamily="@font/outfit_medium"
                android:textColor="@color/home_ink"
                android:text="@string/notices_empty" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_horizontal"
                android:textSize="12.5sp"
                android:fontFamily="@font/inter_regular"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/home_muted"
                android:text="@string/notices_empty_sub" />
        </LinearLayout>

        <TextView
            android:id="@+id/notices_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="16dp"
            android:textSize="13sp"
            android:textColor="@color/danger"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
